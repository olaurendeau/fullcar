{
  "mode": "integrated",
  "language": {
    "human": "fr",
    "artifacts": "fr",
    "agents": "en"
  },
  "base_branch": "main",
  "check": {
    "full": "npm run check",
    "affected": "npm run check",
    "cleanup": "rm -f var/slot-{slot}.sqlite"
  },
  "slots": {
    "var": "SLOT",
    "developers": [1, 2, 3],
    "reviewer": 9
  },
  "pr": {
    "max_lines": 1000,
    "exclude": ["package-lock.json"],
    "title": "conventional"
  },
  "merge": {
    "required_checks": ["checks"],
    "review_status": "agent-review",
    "sensitive_paths": [
      ".github/**",
      ".claude/**",
      "docs/agents/**",
      "migrations/**",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      "compose.yaml"
    ],
    "sensitive_patterns": [
      { "regex": "randomBytes|randomUUID|Math\\.random|createHash|timingSafeEqual" },
      { "regex": "admin_token|owner_token|Referrer-Policy" },
      { "regex": "\\bphone\\b" },
      { "regex": "purge|DROP TABLE|DELETE FROM" },
      { "file": "package.json", "regex": "\"(dependencies|scripts)\"" }
    ]
  },
  "commands": [
    { "cmd": "npm", "deny_args": "^(publish|version)\\b", "reason": "publication and version bumps are the human's" },
    { "cmd": "clever", "allow_args": "^(logs|status|activity|env list)\\b", "reason": "read-only: deploys are the human's" },
    { "cmd": "scalingo", "allow_args": "^(logs|ps|deployments|env)\\b", "reason": "read-only: deploys are the human's" }
  ],
  "context": {
    "product": "docs/agents/product.md",
    "architecture": "docs/agents/architecture.md",
    "review_checklist": "docs/agents/review-checklist.md",
    "glossary": "docs/agents/glossary.md"
  },
  "verify_ui": {
    "kind": "playwright",
    "up": "npm run dev -- --port 30{slot}0",
    "test": "npm run e2e -- --base-url http://localhost:30{slot}0",
    "shot": "npm run shot -- --width 360 --base-url http://localhost:30{slot}0",
    "down": "npm run dev:stop -- --port 30{slot}0"
  },
  "escalation_extra": [
    "ajouter un compte, une adresse e-mail obligatoire, de la publicité ou du tracking",
    "changer ce qui est stocké, ou qui peut voir un numéro de téléphone",
    "toucher à la génération, au stockage ou à la journalisation d'un jeton",
    "l'hébergement et le nom de domaine",
    "sortir un sujet du hors-périmètre V1 (carte, notifications, appariement, paiement, messagerie)"
  ]
}
