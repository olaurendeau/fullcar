{
  "mode": "integrated",
  "language": {
    "human": "fr",
    "artifacts": "fr",
    "agents": "en"
  },
  "base_branch": "main",
  "check": {
    "full": "make ci SLOT={slot}",
    "affected": "make check SLOT={slot}",
    "cleanup": "make down SLOT={slot}"
  },
  "slots": {
    "var": "SLOT",
    "developers": [
      1,
      2,
      3
    ],
    "reviewer": 9
  },
  "pr": {
    "max_lines": 1500,
    "exclude": [
      "package-lock.json"
    ],
    "title": "conventional"
  },
  "merge": {
    "required_checks": [
      "checks"
    ],
    "review_status": "agent-review",
    "sensitive_paths": [
      ".github/**",
      ".claude/**",
      "docs/agents/review-checklist.md",
      "**/migrations/**",
      "src/domain/phone-visibility.ts",
      "src/db/event-rows.ts",
      "package.json",
      "package-lock.json",
      ".env*",
      "**/.env*",
      "vercel.json",
      "next.config.*",
      "middleware.ts",
      "src/middleware.ts",
      "proxy.ts",
      "src/proxy.ts",
      "Makefile",
      "Dockerfile*",
      ".dockerignore",
      "docker/**",
      "tsconfig.json",
      "eslint.config.*"
    ],
    "sensitive_patterns": [
      {
        "regex": "randomBytes|randomUUID|getRandomValues|Math\\.random|createHash|timingSafeEqual",
        "exclude": [
          "docs/design/**",
          "e2e/**",
          "**/*.test.ts",
          "**/*.test.tsx"
        ]
      },
      {
        "regex": "(?i)token_?hash|newAdminToken|hashAdminToken|adminTokenMatches|hashToken|tokenMatches|personalTokenFromBytes|tokenInFragment|readDeviceToken|ensureDeviceToken|\\binsertEvent\\s*\\(|\\b(get|set|remove)Item\\s*\\(|[\"'`]token[\"'`]|[\"'`][^\"'`\\s/]*[-_]token[\"'`]|\\$\\{[^}]*token\\b[^}]*\\}|\\+=?\\s*[\\w.]*token\\b|\\b(console|logger|log)\\.\\w+\\s*\\(.*token\\b|\\b(console|logger)\\.\\w+\\s*\\(\\s*$|URLSearchParams|searchParams\\.(set|append)|localStorage|sessionStorage|location\\.hash|location\\.href|split\\(\\s*[\"'`]#|referrerpolicy\\s*[=:]|name=[\"'`]referrer|http-?equiv=[\"'`]referrer-policy|cookies\\(\\)|\\.cookies\\.(set|delete)|cookieStore|document\\.cookie|Set-Cookie",
        "exclude": [
          "docs/design/**",
          "e2e/**",
          "**/*.test.ts",
          "**/*.test.tsx"
        ]
      },
      {
        "file": "src/observability/**",
        "regex": "\\.hash\\b",
        "exclude": [
          "**/*.test.ts"
        ]
      },
      {
        "file": "src/db/**",
        "regex": "(?i)phone",
        "exclude": [
          "**/*.test.ts"
        ]
      },
      {
        "regex": "[\"'`](\\w+\\.)?person(\\s+(as|AS|As)\\s+\\w+)?[\"'`]|\\bsql\\.(table|id)\\(\\s*[\"'`](\\w+\\.)?person\\b|\\b(from|FROM|join|JOIN)\\s+(\"?\\w+\"?\\.)?\"?person\\b|\\bsql\\s*(<[^`]*>)?\\s*`|\\bref\\(\\s*[\"'`](\\w+\\.)?phone\\b",
        "exclude": [
          "src/db/**",
          "**/*.test.ts",
          "**/*.test.tsx",
          "e2e/**",
          "messages/**",
          "**/*.md",
          "src/components/**",
          "src/domain/**",
          "docs/design/**"
        ]
      },
      {
        "file": "src/**",
        "regex": "\\b(selectAll|returningAll)\\b|\\b(select|SELECT|returning|RETURNING)\\s+\\*|[\\w\"]\\.\\*|\\b(toJson|jsonb?Agg)\\b|\\b(to_jsonb?|TO_JSONB?|row_to_json|ROW_TO_JSON|jsonb?_agg|JSONB?_AGG|array_agg|ARRAY_AGG)\\b",
        "exclude": [
          "**/*.test.ts",
          "**/*.test.tsx"
        ]
      },
      {
        "regex": "eslint-disable|@ts-nocheck|@ts-expect-error|@ts-ignore|\\.(only|skip|skipIf|runIf|todo|fails|fixme)\\s*[(`]|\\b(it|test|describe|suite|bench|testInfo)(\\.\\w+)*\\.(only|skip|skipIf|runIf|todo|fails|fail|fixme)\\b|\\b(info|test\\.info\\(\\))\\.fail\\b|\\bx(it|describe|test)\\(",
        "exclude": [
          "docs/design/**"
        ]
      },
      {
        "regex": "purge|CRON_SECRET|deleteFrom|dropTable|DROP TABLE|DELETE FROM|ON DELETE",
        "exclude": [
          "docs/design/**",
          "e2e/**",
          "**/*.test.ts",
          "**/*.test.tsx"
        ]
      },
      {
        "regex": "DATABASE_URL|POSTGRES_(PRISMA_)?URL",
        "exclude": [
          "**/*.test.ts",
          "e2e/**",
          "docs/design/**"
        ]
      },
      {
        "regex": "@vercel/analytics|@vercel/speed-insights",
        "exclude": [
          "docs/design/**"
        ]
      },
      {
        "file": "package.json",
        "regex": "\"(dependencies|devDependencies|scripts)\""
      }
    ]
  },
  "commands": [
    {
      "cmd": "npm",
      "deny_args": "\\b(publish|unpublish|version|dist-tag|deprecate)\\b",
      "reason": "publication and version bumps are the human's"
    },
    {
      "cmd": "make",
      "deny_args": "\\b(publish|unpublish|version|dist-tag|deprecate)\\b",
      "reason": "publication and version bumps are the human's, including through make npm ARGS=\"…\""
    },
    {
      "cmd": "docker",
      "deny_args": "\\b(prune|push|login)\\b|(^|\\s)(rm|remove)\\b|\\bdown\\b.*\\s(-[A-Za-z]*v[A-Za-z]*|--volumes)\\b|\\bcompose\\b.*\\s(-p|--project-name\\b)|\\bnpm\\b.*\\b(publish|unpublish|version|dist-tag|deprecate)\\b",
      "reason": "removing volumes or containers, or naming another Compose project, wipes other slots' data (make down SLOT={slot} is the way); registries and npm publication are the human's"
    },
    {
      "cmd": "vercel",
      "allow_args": "^(ls|list|inspect|logs|whoami|project ls)\\b",
      "reason": "read-only: deploys, env and domains are the human's"
    },
    {
      "cmd": "vc",
      "allow_args": "^(ls|list|inspect|logs|whoami|project ls)\\b",
      "reason": "read-only: deploys, env and domains are the human's"
    },
    {
      "cmd": "neonctl",
      "allow_args": "^(me|projects list|branches list)\\b",
      "reason": "read-only, and never a connection string: the production database is the human's"
    },
    {
      "cmd": "neon",
      "allow_args": "^(me|projects list|branches list)\\b",
      "reason": "read-only, and never a connection string: the production database is the human's"
    }
  ],
  "db_hosts_allowed": [
    "db"
  ],
  "context": {
    "product": "docs/agents/product.md",
    "architecture": "docs/agents/architecture.md",
    "review_checklist": "docs/agents/review-checklist.md",
    "glossary": "docs/agents/glossary.md"
  },
  "verify_ui": {
    "kind": "playwright",
    "up": "make up SLOT={slot}",
    "test": "make e2e SLOT={slot}",
    "shot": "make shot SLOT={slot} WIDTH=360",
    "down": "make down SLOT={slot}"
  },
  "escalation_extra": [
    "ajouter un compte, une adresse e-mail obligatoire, de la publicité ou du tracking",
    "changer ce qui est stocké, ou qui peut voir un numéro de téléphone",
    "toucher à la génération, au stockage ou à la journalisation d'un jeton",
    "l'hébergement (Vercel, Neon), leur plan et le nom de domaine",
    "sortir un sujet du hors-périmètre V1 (carte, notifications, appariement, paiement, messagerie)"
  ]
}
